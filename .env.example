# Шаблон конфигурации. Скопируйте в .env (прод) или .env.dev (разработка).
# Порядок чтения: системное окружение -> .env.{APP_ENV} -> .env
# (dotenvy не перезаписывает уже заданные переменные, поэтому файл .env.{APP_ENV} приоритетнее .env).

# Строка подключения к БД, например: sqlite:./data/app.db
DATABASE_URL=sqlite:./sqlite.db

# Адрес и порт для привязки сервера.
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Приветственное сообщение при старте (выводится в лог).
START_MESSAGE=Hello

# Только для prod: список разрешённых CORS-origin'ов через запятую.
# Пусто (значение по умолчанию) — CORS-заголовки не отдаются вообще,
# браузеры блокируют запросы с чужих origin'ов.
CORS_ALLOWED_ORIGINS=
